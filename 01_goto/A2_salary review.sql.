SET SERVEROUTPUT ON;
SQL> DECLARE
     v_salary NUMBER := 55000;
    BEGIN
      IF v_salary < 30000 THEN
    GOTO low_salary;
     ELSIF v_salary BETWEEN 30000 AND 70000 THEN
     GOTO medium_salary;
    ELSE
     GOTO high_salary;
    END IF;
   <<low_salary>>
    DBMS_OUTPUT.PUT_LINE('Salary Category: Low Grade');
   GOTO finish;
     <<medium_salary>>
   DBMS_OUTPUT.PUT_LINE('Salary Category: Medium Grade');
   GOTO finish;
   <<high_salary>>
   DBMS_OUTPUT.PUT_LINE('Salary Category: High Grade');
    GOTO finish;
     <<finish>>
   DBMS_OUTPUT.PUT_LINE('Salary review finished successfully.');
   END;
   /
